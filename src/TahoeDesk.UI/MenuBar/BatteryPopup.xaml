<Popup x:Class="TahoeDesk.UI.MenuBar.BatteryPopup"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:glass="clr-namespace:TahoeDesk.UI.Glass"
       AllowsTransparency="True"
       PopupAnimation="Fade"
       StaysOpen="False"
       Placement="Bottom">
    <Popup.Resources>
        <Style x:Key="BatRowBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="10,7">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BatHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Popup.Resources>

    <Grid Width="272"
          TextOptions.TextFormattingMode="Ideal"
          TextOptions.TextRenderingMode="Grayscale">
        <glass:LiquidGlassSurface x:Name="GlassBackdrop"
                                  CornerRadius="16"
                                  ShadowPadding="16"
                                  IsOverlayCard="True"
                                  IsDarkMode="True" />

        <StackPanel Margin="26,22,26,22">
            <DockPanel Margin="2,0,2,2">
                <TextBlock Text="电池" FontSize="14" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI, Segoe UI" Foreground="{DynamicResource BatFgBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="PercentHeaderText" DockPanel.Dock="Right" HorizontalAlignment="Right" Text="100%" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BatFgBrush}" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock x:Name="StatusSubText" Text="电源适配器供电" FontSize="11.5" FontFamily="Microsoft YaHei UI, Segoe UI" Foreground="{DynamicResource BatSubtleBrush}" Margin="2,0,2,10" />

            <Border Height="1" Background="{DynamicResource BatDividerBrush}" Margin="0,0,0,8" />

            <TextBlock Text="电源模式" FontSize="11" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI, Segoe UI" Foreground="{DynamicResource BatSubtleBrush}" Margin="4,0,0,4" />

            <Button x:Name="EfficiencyBtn" Style="{StaticResource BatRowBtnStyle}" Click="OnEfficiencyClick">
                <DockPanel>
                    <TextBlock x:Name="EfficiencyCheck" DockPanel.Dock="Right" Text="✓" FontSize="13" FontWeight="Bold" Foreground="#0A84FF" Visibility="Collapsed" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Text="最佳能效（节能）" FontSize="12.5" FontFamily="Microsoft YaHei UI, Segoe UI" Foreground="{DynamicResource BatFgBrush}" />
                        <TextBlock Text="延长续航，降低风扇噪音" FontSize="10.5" FontFamily="Microsoft YaHei UI, Segoe UI" Foreground="{DynamicResource BatSubtleBrush}" />
                    </StackPanel>
                </DockPanel>
            </Button>

            <Button x:Name="BalancedBtn" Style="{StaticResource BatRowBtnStyle}" Click="OnBalancedClick">
                <DockPanel>
                    <TextBlock x:Name="BalancedCheck" DockPanel.Dock="Right" Text="✓" FontSize="13" FontWeight="Bold" Foreground="#0A84FF" Visibility="Collapsed" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Text="平衡" FontSize="12.5" FontFamily="Microsoft YaHei UI, Segoe UI" Foreground="{DynamicResource BatFgBrush}" />
                        <TextBlock Text="自动平衡性能与功耗" FontSize="10.5" FontFamily="Microsoft YaHei UI, Segoe UI" Foreground="{DynamicResource BatSubtleBrush}" />
                    </StackPanel>
                </DockPanel>
            </Button>

            <Button x:Name="PerformanceBtn" Style="{StaticResource BatRowBtnStyle}" Click="OnPerformanceClick">
                <DockPanel>
                    <TextBlock x:Name="PerformanceCheck" DockPanel.Dock="Right" Text="✓" FontSize="13" FontWeight="Bold" Foreground="#0A84FF" Visibility="Collapsed" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Text="最佳性能" FontSize="12.5" FontFamily="Microsoft YaHei UI, Segoe UI" Foreground="{DynamicResource BatFgBrush}" />
                        <TextBlock Text="优先释放最大算力" FontSize="10.5" FontFamily="Microsoft YaHei UI, Segoe UI" Foreground="{DynamicResource BatSubtleBrush}" />
                    </StackPanel>
                </DockPanel>
            </Button>

            <Border Height="1" Background="{DynamicResource BatDividerBrush}" Margin="0,8,0,8" />

            <Button Style="{StaticResource BatRowBtnStyle}" Background="{DynamicResource BatBtnBgBrush}" HorizontalContentAlignment="Center" Click="OnOpenPowerSettingsClick">
                <TextBlock Text="电源与电池设置…" FontSize="12" FontFamily="Microsoft YaHei UI, Segoe UI" Foreground="{DynamicResource BatFgBrush}" HorizontalAlignment="Center" />
            </Button>
        </StackPanel>
    </Grid>
</Popup>
