<Window x:Class="TahoeDesk.UI.MenuBar.AboutPcDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:glass="clr-namespace:TahoeDesk.UI.Glass"
        Title="关于本机"
        Width="340"
        Height="320"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True">
    <Grid>
        <glass:LiquidGlassSurface x:Name="GlassBackdrop"
                                  CornerRadius="20"
                                  ShadowPadding="16"
                                  IsOverlayCard="True"
                                  IsDarkMode="True" />
        <StackPanel Margin="28,24,28,24" HorizontalAlignment="Center">
            <Image Source="pack://application:,,,/Assets/TahoeDesk.png"
                   Width="72"
                   Height="72"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Margin="0,2,0,12" />
            <TextBlock x:Name="MachineNameText" FontSize="20" FontWeight="SemiBold" Foreground="#F5FFFFFF" HorizontalAlignment="Center" />
            <TextBlock Text="TahoeDesk 液态玻璃桌面" FontSize="12" Foreground="#99FFFFFF" HorizontalAlignment="Center" Margin="0,2,0,16" />

            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="22" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="22" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="系统版本" Foreground="#99FFFFFF" FontSize="12" HorizontalAlignment="Right" Margin="0,0,10,0" />
                <TextBlock x:Name="OsVersionText" Grid.Row="0" Grid.Column="1" Foreground="#F0FFFFFF" FontSize="12" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="处理器" Foreground="#99FFFFFF" FontSize="12" HorizontalAlignment="Right" Margin="0,0,10,0" />
                <TextBlock x:Name="CpuText" Grid.Row="1" Grid.Column="1" Foreground="#F0FFFFFF" FontSize="12" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="物理内存" Foreground="#99FFFFFF" FontSize="12" HorizontalAlignment="Right" Margin="0,0,10,0" />
                <TextBlock x:Name="MemoryText" Grid.Row="2" Grid.Column="1" Foreground="#F0FFFFFF" FontSize="12" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="桌面版本" Foreground="#99FFFFFF" FontSize="12" HorizontalAlignment="Right" Margin="0,0,10,0" />
                <TextBlock Text="TahoeDesk v1.0.1" Grid.Row="3" Grid.Column="1" Foreground="#F0FFFFFF" FontSize="12" />
            </Grid>

            <Button Content="关闭" Width="96" Height="28" Background="#33FFFFFF" Foreground="#F5FFFFFF" BorderThickness="0" Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
