<Window x:Class="TahoeDesk.UI.Settings.QuickSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:glass="clr-namespace:TahoeDesk.UI.Glass"
        Title="TahoeDesk 设置"
        Width="464"
        Height="596"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        Topmost="True">
    <Grid>
        <glass:LiquidGlassSurface x:Name="GlassBackdrop"
                                  CornerRadius="20"
                                  ShadowPadding="16"
                                  IsOverlayCard="True"
                                  IsDarkMode="True" />

        <DockPanel Margin="32,28,32,26">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <TextBlock Text="系统设置 · TahoeDesk"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SettingsFgBrush}"
                           VerticalAlignment="Center" />
                <Button Content="✕"
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        Width="26"
                        Height="26"
                        Background="{DynamicResource SettingsCloseBgBrush}"
                        Foreground="{DynamicResource SettingsFgBrush}"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="OnCloseClick" />
            </DockPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <Button Content="退出 TahoeDesk"
                        Height="34"
                        Background="#D8FF3B30"
                        Foreground="White"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="OnRestoreAndExitClick" />
                <TextBlock x:Name="VersionFooterText"
                           Text="TahoeDesk v1.0.0 · Liquid Glass Desktop Shell"
                           FontSize="10.5"
                           Foreground="{DynamicResource SettingsSubtleBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="外观与液态玻璃" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource SettingsSubtleBrush}" Margin="2,0,0,6" />
                    <Border Background="{DynamicResource SettingsCardBgBrush}"
                            BorderBrush="{DynamicResource SettingsCardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="深浅主题" Foreground="{DynamicResource SettingsFgBrush}" VerticalAlignment="Center" />
                                <ComboBox x:Name="ThemeCombo" Width="140" HorizontalAlignment="Right" SelectionChanged="OnSettingChanged" DropDownOpened="OnComboDropDownOpened">
                                    <ComboBoxItem Content="跟随系统" Tag="System" />
                                    <ComboBoxItem Content="浅色" Tag="Light" />
                                    <ComboBoxItem Content="深色" Tag="Dark" />
                                </ComboBox>
                            </DockPanel>

                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="液态玻璃通透度" Foreground="{DynamicResource SettingsFgBrush}" VerticalAlignment="Center" />
                                <ComboBox x:Name="OpacityCombo" Width="140" HorizontalAlignment="Right" SelectionChanged="OnSettingChanged" DropDownOpened="OnComboDropDownOpened">
                                    <ComboBoxItem Content="通透 (Tahoe)" Tag="Clear" />
                                    <ComboBoxItem Content="平衡" Tag="Balanced" />
                                    <ComboBoxItem Content="磨砂" Tag="Frosted" />
                                </ComboBox>
                            </DockPanel>

                            <CheckBox x:Name="MenuBarBgCheck"
                                      Content="显示顶部菜单栏液态玻璃底色"
                                      Foreground="{DynamicResource SettingsFgBrush}"
                                      Checked="OnSettingChanged"
                                      Unchecked="OnSettingChanged" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="程序坞 (Dock)" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource SettingsSubtleBrush}" Margin="2,0,0,6" />
                    <Border Background="{DynamicResource SettingsCardBgBrush}"
                            BorderBrush="{DynamicResource SettingsCardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="图标大小" Foreground="{DynamicResource SettingsFgBrush}" VerticalAlignment="Center" />
                                <Slider x:Name="IconSizeSlider" Minimum="36" Maximum="72" Width="165" HorizontalAlignment="Right" ValueChanged="OnSettingChanged" />
                            </DockPanel>

                            <CheckBox x:Name="MagnificationCheck"
                                      Content="悬停波浪放大"
                                      Foreground="{DynamicResource SettingsFgBrush}"
                                      Margin="0,0,0,8"
                                      Checked="OnSettingChanged"
                                      Unchecked="OnSettingChanged" />

                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="放大倍率" Foreground="{DynamicResource SettingsFgBrush}" VerticalAlignment="Center" />
                                <Slider x:Name="MagScaleSlider" Minimum="1.2" Maximum="2.0" SmallChange="0.1" Width="165" HorizontalAlignment="Right" ValueChanged="OnSettingChanged" />
                            </DockPanel>

                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="自动隐藏程序坞" Foreground="{DynamicResource SettingsFgBrush}" VerticalAlignment="Center" />
                                <ComboBox x:Name="AutoHideCombo" Width="170" HorizontalAlignment="Right" SelectionChanged="OnSettingChanged" DropDownOpened="OnComboDropDownOpened">
                                    <ComboBoxItem Content="最大化与全屏时隐藏（推荐）" Tag="Smart" />
                                    <ComboBoxItem Content="仅全屏视频/游戏时隐藏" Tag="Off" />
                                    <ComboBoxItem Content="始终自动隐藏" Tag="Always" />
                                </ComboBox>
                            </DockPanel>

                            <CheckBox x:Name="HarmonizeIconsCheck"
                                      Content="图标 Squircle 视觉统一（柔和圆角底板）"
                                      Foreground="{DynamicResource SettingsFgBrush}"
                                      Margin="0,0,0,8"
                                      Checked="OnSettingChanged"
                                      Unchecked="OnSettingChanged" />

                            <CheckBox x:Name="RecentAppsCheck"
                                      Content="在程序坞中显示最近使用的应用"
                                      Foreground="{DynamicResource SettingsFgBrush}"
                                      Margin="0,0,0,8"
                                      Checked="OnSettingChanged"
                                      Unchecked="OnSettingChanged" />

                            <CheckBox x:Name="WinKeyLaunchpadCheck"
                                      Content="单按 Win 键呼出启动台（组合键正常保留）"
                                      Foreground="{DynamicResource SettingsFgBrush}"
                                      Margin="0,0,0,10"
                                      Checked="OnSettingChanged"
                                      Unchecked="OnSettingChanged" />

                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="启动台每页列数" Foreground="{DynamicResource SettingsFgBrush}" VerticalAlignment="Center" />
                                <ComboBox x:Name="LaunchpadColsCombo" Width="110" HorizontalAlignment="Right" SelectionChanged="OnSettingChanged" DropDownOpened="OnComboDropDownOpened">
                                    <ComboBoxItem Content="5 列" Tag="5" />
                                    <ComboBoxItem Content="6 列" Tag="6" />
                                    <ComboBoxItem Content="7 列（默认）" Tag="7" />
                                    <ComboBoxItem Content="8 列" Tag="8" />
                                    <ComboBoxItem Content="9 列" Tag="9" />
                                    <ComboBoxItem Content="10 列" Tag="10" />
                                </ComboBox>
                            </DockPanel>

                            <DockPanel>
                                <TextBlock Text="启动台每页行数" Foreground="{DynamicResource SettingsFgBrush}" VerticalAlignment="Center" />
                                <ComboBox x:Name="LaunchpadRowsCombo" Width="110" HorizontalAlignment="Right" SelectionChanged="OnSettingChanged" DropDownOpened="OnComboDropDownOpened">
                                    <ComboBoxItem Content="3 行" Tag="3" />
                                    <ComboBoxItem Content="4 行" Tag="4" />
                                    <ComboBoxItem Content="5 行（默认）" Tag="5" />
                                    <ComboBoxItem Content="6 行" Tag="6" />
                                    <ComboBoxItem Content="7 行" Tag="7" />
                                </ComboBox>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="通用与诊断" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource SettingsSubtleBrush}" Margin="2,0,0,6" />
                    <Border Background="{DynamicResource SettingsCardBgBrush}"
                            BorderBrush="{DynamicResource SettingsCardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14">
                        <StackPanel>
                            <CheckBox x:Name="AutoStartCheck"
                                      Content="开机自动启动 TahoeDesk（当前用户）"
                                      Foreground="{DynamicResource SettingsFgBrush}"
                                      Margin="0,0,0,10"
                                      Checked="OnAutoStartChanged"
                                      Unchecked="OnAutoStartChanged" />

                            <DockPanel>
                                <TextBlock x:Name="DiagStatusText"
                                           Text="排查问题时可一键导出脱敏运行报告"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource SettingsSubtleBrush}"
                                           VerticalAlignment="Center" />
                                <Button x:Name="ExportDiagButton"
                                        Content="导出诊断报告"
                                        DockPanel.Dock="Right"
                                        HorizontalAlignment="Right"
                                        Padding="10,5"
                                        FontSize="11.5"
                                        Background="{DynamicResource SettingsCloseBgBrush}"
                                        Foreground="{DynamicResource SettingsFgBrush}"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="OnExportDiagnosticsClick" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
