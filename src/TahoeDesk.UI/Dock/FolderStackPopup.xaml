<Popup x:Class="TahoeDesk.UI.Dock.FolderStackPopup"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:glass="clr-namespace:TahoeDesk.UI.Glass"
       AllowsTransparency="True"
       PopupAnimation="Fade"
       StaysOpen="False"
       Placement="Top">
    <Grid Width="364"
          TextOptions.TextFormattingMode="Ideal"
          TextOptions.TextRenderingMode="Grayscale">
        <glass:LiquidGlassSurface x:Name="GlassBackdrop"
                                  CornerRadius="16"
                                  ShadowPadding="16"
                                  IsOverlayCard="True"
                                  IsDarkMode="True" />

        <StackPanel Margin="26,24,26,24">
            <DockPanel Margin="4,0,4,10">
                <TextBlock x:Name="FolderTitleText"
                           FontSize="14"
                           FontWeight="SemiBold"
                           FontFamily="Microsoft YaHei UI, Segoe UI"
                           Foreground="{DynamicResource StackFgBrush}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="ItemCountText"
                           DockPanel.Dock="Right"
                           HorizontalAlignment="Right"
                           FontSize="11.5"
                           FontFamily="Microsoft YaHei UI, Segoe UI"
                           Foreground="{DynamicResource StackSubtleBrush}"
                           VerticalAlignment="Center" />
            </DockPanel>

            <ScrollViewer MaxHeight="264" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <WrapPanel x:Name="ItemsGrid" Orientation="Horizontal" ItemWidth="78" ItemHeight="82" />
            </ScrollViewer>

            <TextBlock x:Name="EmptyText"
                       Text="此文件夹为空"
                       FontSize="12.5"
                       FontFamily="Microsoft YaHei UI, Segoe UI"
                       Foreground="{DynamicResource StackSubtleBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,24,0,24"
                       Visibility="Collapsed" />

            <Border Height="1" Background="{DynamicResource StackDividerBrush}" Margin="0,10,0,10" />

            <Button x:Name="OpenInExplorerButton"
                    Content="在资源管理器中打开"
                    Height="30"
                    Background="{DynamicResource StackBtnBgBrush}"
                    Foreground="{DynamicResource StackFgBrush}"
                    BorderThickness="0"
                    FontSize="12"
                    FontFamily="Microsoft YaHei UI, Segoe UI"
                    Cursor="Hand"
                    Click="OnOpenInExplorerClick">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Popup>
