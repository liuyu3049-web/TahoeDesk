<Popup x:Class="GlassShell.UI.Dock.DockTooltipPopup"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       AllowsTransparency="True"
       PopupAnimation="Fade"
       StaysOpen="True"
       IsHitTestVisible="False"
       Placement="Top">
    <StackPanel HorizontalAlignment="Center">
        <Border Background="#CC1E2028"
                BorderBrush="#48FFFFFF"
                BorderThickness="0.8"
                CornerRadius="7"
                Padding="10,4">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.38" />
            </Border.Effect>
            <TextBlock x:Name="LabelText"
                       Foreground="#F5FFFFFF"
                       FontSize="12"
                       FontFamily="Segoe UI Variable Text, Microsoft YaHei UI"
                       HorizontalAlignment="Center" />
        </Border>
        <Polygon Points="0,0 10,0 5,5"
                 Fill="#CC1E2028"
                 HorizontalAlignment="Center"
                 Margin="0,-0.5,0,0" />
    </StackPanel>
</Popup>
