<Window x:Class="GlassShell.UI.Dock.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:glass="clr-namespace:GlassShell.UI.Glass"
        Title="GlassShell Dock"
        Height="148"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        AllowDrop="True"
        Topmost="True">
    <Grid x:Name="RootContainer" VerticalAlignment="Bottom" Margin="0,0,0,6">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" Y="0" />
        </Grid.RenderTransform>

        <!-- Fixed full-width GPU surface (IsHitTestVisible=False); capsule width animates purely in HLSL with ZERO GPU reallocations! -->
        <glass:LiquidGlassSurface x:Name="CapsuleGlass"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Bottom"
                                  Height="98"
                                  CornerRadius="22"
                                  ShadowPadding="16"
                                  IsDarkMode="True" />

        <!-- Dynamic positioned icon canvas aligned with the capsule bottom -->
        <Canvas x:Name="IconsCanvas"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Height="136"
                Width="336"
                Margin="0,0,0,16"
                Background="Transparent" />
    </Grid>
</Window>
