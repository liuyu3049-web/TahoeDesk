<Window x:Class="GlassShell.UI.Launchpad.LaunchpadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GlassShell Launchpad"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#141824"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        PreviewMouseWheel="OnWindowPreviewMouseWheel">
    <Grid x:Name="RootGrid" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1.0" ScaleY="1.0" />
        </Grid.RenderTransform>

        <!-- True macOS Launchpad blurred desktop wallpaper (100% DirectX hardware accelerated, 0 UpdateLayeredWindow lag!) -->
        <Image x:Name="WallpaperBlurImage"
               Stretch="UniformToFill"
               RenderOptions.BitmapScalingMode="Linear"
               IsHitTestVisible="False" />

        <!-- Airy translucent glass scrim over blurred wallpaper -->
        <Border x:Name="VeilBackdrop"
                Background="#480E121E"
                MouseLeftButtonDown="OnBackgroundClick" />

        <!-- Main macOS Launchpad Grid Layout -->
        <Grid Margin="110,44,110,36">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top centered frosted pill search bar (authentic macOS Launchpad style) -->
            <Border Grid.Row="0"
                    Width="272"
                    Height="32"
                    HorizontalAlignment="Center"
                    CornerRadius="16"
                    Background="#2EFFFFFF"
                    BorderBrush="#52FFFFFF"
                    BorderThickness="0.9">
                <DockPanel Margin="12,0">
                    <TextBlock Text="⌕"
                               FontSize="14"
                               Foreground="#CCFFFFFF"
                               VerticalAlignment="Center"
                               Margin="0,0,7,1" />
                    <Grid VerticalAlignment="Center">
                        <TextBlock x:Name="SearchPlaceholder"
                                   Text="搜索"
                                   FontSize="13"
                                   FontFamily="Microsoft YaHei UI, Segoe UI"
                                   Foreground="#B4FFFFFF"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center" />
                        <TextBox x:Name="SearchBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#FAFFFFFF"
                                 CaretBrush="#FAFFFFFF"
                                 FontSize="13"
                                 FontFamily="Microsoft YaHei UI, Segoe UI"
                                 VerticalContentAlignment="Center"
                                 TextChanged="OnSearchTextChanged" />
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Authentic macOS 7x5 floating icon grid -->
            <UniformGrid x:Name="AppsGrid"
                         Grid.Row="1"
                         Columns="7"
                         Rows="5"
                         Margin="0,28,0,18"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch" />

            <!-- Page indicator dots -->
            <StackPanel x:Name="PageDotsPanel"
                        Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
        </Grid>

        <!-- Inline macOS Frosted Glass Folder Overlay -->
        <Grid x:Name="FolderOverlay"
              Visibility="Collapsed"
              Background="#52000000"
              MouseLeftButtonDown="OnFolderBackdropClick">
            <Border Width="580"
                    MaxHeight="460"
                    CornerRadius="30"
                    Background="#B8242A3A"
                    BorderBrush="#5CFFFFFF"
                    BorderThickness="1.1"
                    Padding="30,22,30,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MouseLeftButtonDown="OnFolderCardMouseDown">
                <StackPanel>
                    <TextBox x:Name="FolderTitleBox"
                             FontSize="22"
                             FontWeight="Medium"
                             FontFamily="Microsoft YaHei UI, Segoe UI"
                             Foreground="#FAFFFFFF"
                             CaretBrush="#FAFFFFFF"
                             Background="Transparent"
                             BorderThickness="0"
                             HorizontalContentAlignment="Center"
                             Margin="0,0,0,18"
                             LostFocus="OnFolderTitleCommit"
                             KeyDown="OnFolderTitleKeyDown" />
                    <ScrollViewer MaxHeight="316" VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="FolderChildrenPanel"
                                   Orientation="Horizontal"
                                   ItemWidth="124"
                                   ItemHeight="120"
                                   HorizontalAlignment="Center" />
                    </ScrollViewer>
                    <TextBlock Text="右键文件夹内图标可移出文件夹"
                               FontSize="11"
                               FontFamily="Microsoft YaHei UI, Segoe UI"
                               Foreground="#8EFFFFFF"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
