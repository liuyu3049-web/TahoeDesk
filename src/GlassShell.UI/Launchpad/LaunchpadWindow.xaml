<Window x:Class="GlassShell.UI.Launchpad.LaunchpadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:glass="clr-namespace:GlassShell.UI.Glass"
        Title="GlassShell Launchpad"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        PreviewMouseWheel="OnWindowPreviewMouseWheel">
    <Grid x:Name="RootGrid" Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="0.96" ScaleY="0.96" />
        </Grid.RenderTransform>

        <!-- Fast hardware-composited fullscreen dark glass veil (avoids 2560x1440 D3DImage CPU readback stalls!) -->
        <Border x:Name="VeilBackdrop"
                MouseLeftButtonDown="OnBackgroundClick">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                    <GradientStop Color="#CC121726" Offset="0.0" />
                    <GradientStop Color="#D60D111D" Offset="0.5" />
                    <GradientStop Color="#CC151B2C" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Main Launchpad layout -->
        <Grid Margin="72,46,72,38">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top centered Liquid Glass search pill -->
            <Border Grid.Row="0"
                    Width="296"
                    Height="36"
                    HorizontalAlignment="Center"
                    CornerRadius="18"
                    Background="#38FFFFFF"
                    BorderBrush="#5CFFFFFF"
                    BorderThickness="1">
                <DockPanel Margin="14,0">
                    <TextBlock Text="⌕"
                               FontSize="15"
                               Foreground="#CCFFFFFF"
                               VerticalAlignment="Center"
                               Margin="0,0,8,1" />
                    <Grid VerticalAlignment="Center">
                        <TextBlock x:Name="SearchPlaceholder"
                                   Text="搜索应用或拼音首字母"
                                   FontSize="13.5"
                                   FontFamily="Microsoft YaHei UI, Segoe UI"
                                   Foreground="#A6FFFFFF"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center" />
                        <TextBox x:Name="SearchBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#FAFFFFFF"
                                 CaretBrush="#FAFFFFFF"
                                 FontSize="13.5"
                                 FontFamily="Microsoft YaHei UI, Segoe UI"
                                 VerticalContentAlignment="Center"
                                 TextChanged="OnSearchTextChanged" />
                    </Grid>
                </DockPanel>
            </Border>

            <!-- 7x5 Paginated App Grid -->
            <UniformGrid x:Name="AppsGrid"
                         Grid.Row="1"
                         Columns="7"
                         Rows="5"
                         Margin="12,34,12,24"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch" />

            <!-- Page indicator dots -->
            <StackPanel x:Name="PageDotsPanel"
                        Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
        </Grid>

        <!-- Inline Liquid Glass Folder Overlay -->
        <Grid x:Name="FolderOverlay"
              Visibility="Collapsed"
              Background="#55000000"
              MouseLeftButtonDown="OnFolderBackdropClick">
            <Border Width="540"
                    MaxHeight="440"
                    CornerRadius="26"
                    Background="#C81E2432"
                    BorderBrush="#66FFFFFF"
                    BorderThickness="1.2"
                    Padding="28,22,28,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MouseLeftButtonDown="OnFolderCardMouseDown">
                <StackPanel>
                    <TextBox x:Name="FolderTitleBox"
                             FontSize="20"
                             FontWeight="SemiBold"
                             FontFamily="Microsoft YaHei UI, Segoe UI"
                             Foreground="#FAFFFFFF"
                             CaretBrush="#FAFFFFFF"
                             Background="Transparent"
                             BorderThickness="0"
                             HorizontalContentAlignment="Center"
                             Margin="0,0,0,18"
                             LostFocus="OnFolderTitleCommit"
                             KeyDown="OnFolderTitleKeyDown" />
                    <ScrollViewer MaxHeight="310" VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="FolderChildrenPanel"
                                   Orientation="Horizontal"
                                   ItemWidth="116"
                                   ItemHeight="114"
                                   HorizontalAlignment="Center" />
                    </ScrollViewer>
                    <TextBlock Text="右键文件夹内图标可移出文件夹"
                               FontSize="11"
                               FontFamily="Microsoft YaHei UI, Segoe UI"
                               Foreground="#88FFFFFF"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
