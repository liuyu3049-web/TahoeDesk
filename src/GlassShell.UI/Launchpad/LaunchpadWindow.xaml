<Window x:Class="GlassShell.UI.Launchpad.LaunchpadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GlassShell Launchpad"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#141824"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        PreviewMouseWheel="OnWindowPreviewMouseWheel">
    <Grid x:Name="RootGrid"
          RenderTransformOrigin="0.5,0.5"
          MouseMove="OnRootMouseMove"
          MouseLeftButtonUp="OnRootMouseLeftButtonUp"
          LostMouseCapture="OnRootLostMouseCapture">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1.0" ScaleY="1.0" />
        </Grid.RenderTransform>

        <!-- True macOS Launchpad blurred desktop wallpaper (100% DirectX hardware accelerated) -->
        <Image x:Name="WallpaperBlurImage"
               Stretch="UniformToFill"
               RenderOptions.BitmapScalingMode="Linear"
               IsHitTestVisible="False" />

        <!-- Airy translucent glass scrim over blurred wallpaper -->
        <Border x:Name="VeilBackdrop"
                Background="#480E121E"
                MouseLeftButtonDown="OnBackgroundClick" />

        <!-- Cross-page drag edge indicators (visible only while dragging an icon) -->
        <Border x:Name="PrevPageEdgeHint"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Width="64"
                Height="168"
                Margin="14,0,0,0"
                CornerRadius="22"
                Background="#30FFFFFF"
                BorderBrush="#66FFFFFF"
                BorderThickness="1"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="‹" FontSize="28" Foreground="White" HorizontalAlignment="Center" Margin="0,-4,0,2" />
                <TextBlock Text="上一页" FontSize="11" FontFamily="Microsoft YaHei UI, Segoe UI" Foreground="#EEFFFFFF" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <Border x:Name="NextPageEdgeHint"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Width="64"
                Height="168"
                Margin="0,0,14,0"
                CornerRadius="22"
                Background="#30FFFFFF"
                BorderBrush="#66FFFFFF"
                BorderThickness="1"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="›" FontSize="28" Foreground="White" HorizontalAlignment="Center" Margin="0,-4,0,2" />
                <TextBlock Text="下一页" FontSize="11" FontFamily="Microsoft YaHei UI, Segoe UI" Foreground="#EEFFFFFF" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Main macOS Launchpad Grid Layout -->
        <Grid Margin="110,44,110,36">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top centered frosted pill search bar + smart filter + sort + add + sync + rescan -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="236"
                        Height="32"
                        CornerRadius="16"
                        Background="#2EFFFFFF"
                        BorderBrush="#52FFFFFF"
                        BorderThickness="0.9">
                    <DockPanel Margin="12,0">
                        <TextBlock Text="⌕"
                                   FontSize="14"
                                   Foreground="#CCFFFFFF"
                                   VerticalAlignment="Center"
                                   Margin="0,0,7,1" />
                        <Grid VerticalAlignment="Center">
                            <TextBlock x:Name="SearchPlaceholder"
                                       Text="搜索"
                                       FontSize="13"
                                       FontFamily="Microsoft YaHei UI, Segoe UI"
                                       Foreground="#B4FFFFFF"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center" />
                            <TextBox x:Name="SearchBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#FAFFFFFF"
                                     CaretBrush="#FAFFFFFF"
                                     FontSize="13"
                                     FontFamily="Microsoft YaHei UI, Segoe UI"
                                     VerticalContentAlignment="Center"
                                     TextChanged="OnSearchTextChanged" />
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- macOS frosted segmented filter: 主应用 / 全部 / 已隐藏 -->
                <Border Margin="10,0,0,0"
                        Height="32"
                        CornerRadius="16"
                        Background="#28FFFFFF"
                        BorderBrush="#48FFFFFF"
                        BorderThickness="0.9"
                        Padding="3">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="FilterPrimaryBtn" Content="主应用" Height="24" Padding="11,0" Margin="0,0,2,0" FontSize="11.5" FontFamily="Microsoft YaHei UI, Segoe UI" Foreground="White" Background="#66FFFFFF" BorderThickness="0" Cursor="Hand" FocusVisualStyle="{x:Null}" Click="OnFilterPrimaryClick">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="FilterAllBtn" Content="全部" Height="24" Padding="11,0" Margin="0,0,2,0" FontSize="11.5" FontFamily="Microsoft YaHei UI, Segoe UI" Foreground="#CCFFFFFF" Background="Transparent" BorderThickness="0" Cursor="Hand" FocusVisualStyle="{x:Null}" Click="OnFilterAllClick">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="FilterHiddenBtn" Content="已隐藏" Height="24" Padding="11,0" FontSize="11.5" FontFamily="Microsoft YaHei UI, Segoe UI" Foreground="#CCFFFFFF" Background="Transparent" BorderThickness="0" Cursor="Hand" FocusVisualStyle="{x:Null}" Click="OnFilterHiddenClick">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Sort mode toggle pill -->
                <Button x:Name="SortModeBtn"
                        Margin="8,0,0,0"
                        Height="32"
                        Padding="11,0"
                        FontSize="11.5"
                        FontFamily="Microsoft YaHei UI, Segoe UI"
                        Foreground="#F2FFFFFF"
                        Background="#28FFFFFF"
                        BorderBrush="#48FFFFFF"
                        BorderThickness="0.9"
                        Cursor="Hand"
                        FocusVisualStyle="{x:Null}"
                        ToolTip="点击切换排序规则（拖拽至屏幕左右边缘或滚动滚轮可跨页移动，Ctrl+拖拽合并文件夹）"
                        Click="OnCycleSortModeClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock x:Name="SortModeLabel" Text="排序: 自定义" />
                </Button>

                <!-- Manual Add App pill -->
                <Button x:Name="AddAppBtn"
                        Margin="8,0,0,0"
                        Height="32"
                        Padding="11,0"
                        FontSize="11.5"
                        FontFamily="Microsoft YaHei UI, Segoe UI"
                        Foreground="#F2FFFFFF"
                        Background="#28FFFFFF"
                        BorderBrush="#48FFFFFF"
                        BorderThickness="0.9"
                        Cursor="Hand"
                        FocusVisualStyle="{x:Null}"
                        ToolTip="手动添加本地应用程序（.exe 或 .lnk）到启动台"
                        Click="OnAddManualAppClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="+ 添加应用" />
                </Button>

                <!-- Sync order from Windows 11 Start Menu Pinned Apps -->
                <Button x:Name="SyncStartOrderBtn"
                        Margin="8,0,0,0"
                        Height="32"
                        Padding="11,0"
                        FontSize="11.5"
                        FontFamily="Microsoft YaHei UI, Segoe UI"
                        Foreground="#F2FFFFFF"
                        Background="#28FFFFFF"
                        BorderBrush="#48FFFFFF"
                        BorderThickness="0.9"
                        Cursor="Hand"
                        FocusVisualStyle="{x:Null}"
                        ToolTip="按原版 Windows 开始菜单已固定应用的顺序自动排列（保留已隐藏项）"
                        Click="OnSyncStartMenuOrderClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="同步开始菜单排序" />
                </Button>

                <!-- Rescan all Windows apps pill -->
                <Button x:Name="RescanBtn"
                        Margin="8,0,0,0"
                        Height="32"
                        Padding="11,0"
                        FontSize="11.5"
                        FontFamily="Microsoft YaHei UI, Segoe UI"
                        Foreground="#F2FFFFFF"
                        Background="#28FFFFFF"
                        BorderBrush="#48FFFFFF"
                        BorderThickness="0.9"
                        Cursor="Hand"
                        FocusVisualStyle="{x:Null}"
                        ToolTip="重新扫描系统已安装的所有应用"
                        Click="OnRescanClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="↻ 刷新" />
                </Button>
            </StackPanel>

            <!-- Authentic macOS 7x5 floating icon grid -->
            <UniformGrid x:Name="AppsGrid"
                         Grid.Row="1"
                         Columns="7"
                         Rows="5"
                         Margin="0,28,0,18"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch" />

            <!-- Page indicator dots -->
            <StackPanel x:Name="PageDotsPanel"
                        Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
        </Grid>

        <!-- Pure-WPF Mouse-Capture Floating Drag Ghost Layer -->
        <Canvas x:Name="DragOverlayCanvas" IsHitTestVisible="False" />

        <!-- Inline macOS Frosted Glass Folder Overlay -->
        <Grid x:Name="FolderOverlay"
              Visibility="Collapsed"
              Background="#52000000"
              MouseLeftButtonDown="OnFolderBackdropClick">
            <Border Width="580"
                    MaxHeight="460"
                    CornerRadius="30"
                    Background="#B8242A3A"
                    BorderBrush="#5CFFFFFF"
                    BorderThickness="1.1"
                    Padding="30,22,30,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MouseLeftButtonDown="OnFolderCardMouseDown">
                <StackPanel>
                    <TextBox x:Name="FolderTitleBox"
                             FontSize="22"
                             FontWeight="Medium"
                             FontFamily="Microsoft YaHei UI, Segoe UI"
                             Foreground="#FAFFFFFF"
                             CaretBrush="#FAFFFFFF"
                             Background="Transparent"
                             BorderThickness="0"
                             HorizontalContentAlignment="Center"
                             Margin="0,0,0,18"
                             LostFocus="OnFolderTitleCommit"
                             KeyDown="OnFolderTitleKeyDown" />
                    <ScrollViewer MaxHeight="316" VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="FolderChildrenPanel"
                                   Orientation="Horizontal"
                                   ItemWidth="124"
                                   ItemHeight="120"
                                   HorizontalAlignment="Center" />
                    </ScrollViewer>
                    <TextBlock Text="右键文件夹内图标可移出文件夹"
                               FontSize="11"
                               FontFamily="Microsoft YaHei UI, Segoe UI"
                               Foreground="#8EFFFFFF"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
