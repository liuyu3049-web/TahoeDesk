<Popup x:Class="GlassShell.UI.MenuBar.LiquidGlassMenuPopup"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:glass="clr-namespace:GlassShell.UI.Glass"
       AllowsTransparency="True"
       PopupAnimation="Fade"
       StaysOpen="False"
       Placement="Bottom">
    <Grid x:Name="RootGrid" MinWidth="216">
        <glass:LiquidGlassSurface x:Name="GlassBackdrop"
                                  CornerRadius="12"
                                  ShadowPadding="10"
                                  IsDarkMode="True" />
        <StackPanel x:Name="ItemsHost"
                    Margin="15,15,15,15" />
    </Grid>
</Popup>
