<Window x:Class="GlassShell.UI.MenuBar.MenuBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:glass="clr-namespace:GlassShell.UI.Glass"
        Title="GlassShell Menu Bar"
        Height="28"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="False"
        Topmost="True">
    <Window.Resources>
        <ResourceDictionary Source="/Themes/LiquidGlassStyles.xaml" />
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="#01000000" MouseLeftButtonDown="OnBarBackgroundClick">
        <!-- Optional Tahoe translucent background (default off = fully transparent) -->
        <glass:LiquidGlassSurface x:Name="BarGlassBackdrop"
                                  CornerRadius="0"
                                  ShadowPadding="0"
                                  Visibility="Collapsed" />

        <DockPanel LastChildFill="True" Margin="8,0,10,0">
            <!-- Leading: Win11 Logo + Active App Name (Bold) + Dynamic Foreground Menus -->
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="WinLogoButton"
                        Style="{StaticResource MenuBarButtonStyle}"
                        Padding="8,0,8,0"
                        Click="OnWinLogoClick"
                        MouseEnter="OnWinLogoHover">
                    <Path Data="M0,0 H6 V6 H0 Z M7.5,0 H13.5 V6 H7.5 Z M0,7.5 H6 V13.5 H0 Z M7.5,7.5 H13.5 V13.5 H7.5 Z"
                          Fill="{DynamicResource MenuBarForegroundBrush}"
                          Width="13"
                          Height="13"
                          Stretch="Uniform" />
                </Button>

                <Button x:Name="ActiveAppButton"
                        Style="{StaticResource MenuBarButtonStyle}"
                        FontWeight="Bold"
                        Content="{Binding ActiveAppName}"
                        Click="OnActiveAppClick"
                        MouseEnter="OnActiveAppHover" />

                <ItemsControl x:Name="DynamicMenusHost" ItemsSource="{Binding TopLevelMenus}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource MenuBarButtonStyle}"
                                    Content="{Binding Title}"
                                    Click="OnDynamicMenuClick"
                                    MouseEnter="OnDynamicMenuHover" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Trailing: Tray Peek + IME + Battery + Network + Spotlight + Control Center + Clock -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="TrayPeekButton"
                        Style="{StaticResource MenuBarButtonStyle}"
                        Padding="6,0"
                        ToolTip="临时展开系统托盘"
                        Click="OnTrayPeekClick">
                    <TextBlock Text="⌃" FontSize="12" VerticalAlignment="Center" />
                </Button>

                <Button x:Name="ImeButton"
                        Style="{StaticResource MenuBarButtonStyle}"
                        Padding="6,0"
                        ToolTip="切换输入法"
                        Click="OnImeClick">
                    <Border BorderBrush="{DynamicResource MenuBarForegroundBrush}" BorderThickness="1" CornerRadius="3" Padding="3,0">
                        <TextBlock Text="{Binding InputMethodLabel}" FontSize="10" FontWeight="SemiBold" />
                    </Border>
                </Button>

                <Button x:Name="BatteryButton"
                        Style="{StaticResource MenuBarButtonStyle}"
                        Padding="6,0"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="BatteryPercentText" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                        <Border Width="20" Height="10" BorderBrush="{DynamicResource MenuBarForegroundBrush}" BorderThickness="1" CornerRadius="2.5" Padding="1">
                            <Border x:Name="BatteryFillBar" Background="{DynamicResource MenuBarForegroundBrush}" HorizontalAlignment="Left" CornerRadius="1" Width="14" />
                        </Border>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource MenuBarButtonStyle}" Padding="6,0" ToolTip="网络状态">
                    <Path Data="M1,6 A11,11 0 0 1 15,6 M3.5,8.5 A7.5,7.5 0 0 1 12.5,8.5 M6,11 A4,4 0 0 1 10,11 M8,13.5 A0.8,0.8 0 1 1 8,13.49"
                          Stroke="{DynamicResource MenuBarForegroundBrush}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Width="15"
                          Height="13"
                          Stretch="Uniform" />
                </Button>

                <Button Style="{StaticResource MenuBarButtonStyle}"
                        Padding="6,0"
                        ToolTip="聚焦搜索 (Alt+Space)"
                        Click="OnSpotlightClick">
                    <Path Data="M6.5,1 A5.5,5.5 0 1 0 6.5,12 A5.5,5.5 0 1 0 6.5,1 M10.5,10.5 L14.5,14.5"
                          Stroke="{DynamicResource MenuBarForegroundBrush}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Width="13"
                          Height="13"
                          Stretch="Uniform" />
                </Button>

                <Button Style="{StaticResource MenuBarButtonStyle}"
                        Padding="6,0"
                        ToolTip="控制中心"
                        Click="OnControlCenterClick">
                    <Canvas Width="16" Height="13">
                        <Border Canvas.Top="0" Width="16" Height="5.5" CornerRadius="2.75" BorderBrush="{DynamicResource MenuBarForegroundBrush}" BorderThickness="1.2">
                            <Ellipse Width="3.5" Height="3.5" Fill="{DynamicResource MenuBarForegroundBrush}" HorizontalAlignment="Left" Margin="0.5,0,0,0" />
                        </Border>
                        <Border Canvas.Top="7.5" Width="16" Height="5.5" CornerRadius="2.75" Background="{DynamicResource MenuBarForegroundBrush}">
                            <Ellipse Width="3.5" Height="3.5" Fill="{DynamicResource MenuBarInverseDotBrush}" HorizontalAlignment="Right" Margin="0,0,1,0" />
                        </Border>
                    </Canvas>
                </Button>

                <Button x:Name="ClockButton"
                        Style="{StaticResource MenuBarButtonStyle}"
                        Padding="8,0"
                        Click="OnClockClick">
                    <TextBlock Text="{Binding FormattedClock}"
                               Typography.NumeralAlignment="Tabular"
                               VerticalAlignment="Center" />
                </Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
