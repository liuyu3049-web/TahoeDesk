<Window x:Class="GlassShell.UI.MenuBar.ForceQuitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:glass="clr-namespace:GlassShell.UI.Glass"
        Title="强制退出应用程序"
        Width="360"
        Height="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True">
    <Grid>
        <glass:LiquidGlassSurface x:Name="GlassBackdrop"
                                  CornerRadius="18"
                                  ShadowPadding="14"
                                  IsDarkMode="True" />
        <DockPanel Margin="26,22,26,22">
            <TextBlock DockPanel.Dock="Top"
                       Text="强制退出应用程序"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="#F5FFFFFF"
                       Margin="0,0,0,10" />

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="取消" Width="76" Height="28" Margin="0,0,8,0" Background="#28FFFFFF" Foreground="#F0FFFFFF" BorderThickness="0" Click="OnCloseClick" />
                <Button Content="强制退出" Width="88" Height="28" Background="#CCFF3B30" Foreground="White" BorderThickness="0" Click="OnForceQuitClick" />
            </StackPanel>

            <ListBox x:Name="AppsList"
                     Background="#1A000000"
                     BorderThickness="0"
                     Foreground="#F0FFFFFF"
                     DisplayMemberPath="DisplayText" />
        </DockPanel>
    </Grid>
</Window>
