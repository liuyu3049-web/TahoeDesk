<Window x:Class="GlassShell.UI.Settings.QuickSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:glass="clr-namespace:GlassShell.UI.Glass"
        Title="GlassShell 设置"
        Width="440"
        Height="470"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True">
    <Grid>
        <glass:LiquidGlassSurface x:Name="GlassBackdrop"
                                  CornerRadius="20"
                                  ShadowPadding="14"
                                  IsDarkMode="True" />

        <DockPanel Margin="28,24,28,24">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <TextBlock Text="系统设置 · GlassShell"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#F5FFFFFF"
                           VerticalAlignment="Center" />
                <Button Content="✕"
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        Width="26"
                        Height="26"
                        Background="#28FFFFFF"
                        Foreground="#F0FFFFFF"
                        BorderThickness="0"
                        Click="OnCloseClick" />
            </DockPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                <Button Content="恢复 Windows 原生任务栏并退出 GlassShell"
                        Height="34"
                        Background="#CCFF3B30"
                        Foreground="White"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Click="OnRestoreAndExitClick" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="外观与液态玻璃" FontSize="12" Foreground="#99FFFFFF" Margin="0,0,0,6" />
                    <Border Background="#1FFFFFFF" CornerRadius="10" Padding="12" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="深浅主题" Foreground="#F0FFFFFF" VerticalAlignment="Center" />
                                <ComboBox x:Name="ThemeCombo" Width="130" HorizontalAlignment="Right" SelectionChanged="OnSettingChanged">
                                    <ComboBoxItem Content="跟随系统" Tag="System" />
                                    <ComboBoxItem Content="浅色" Tag="Light" />
                                    <ComboBoxItem Content="深色" Tag="Dark" />
                                </ComboBox>
                            </DockPanel>

                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="液态玻璃通透度" Foreground="#F0FFFFFF" VerticalAlignment="Center" />
                                <ComboBox x:Name="OpacityCombo" Width="130" HorizontalAlignment="Right" SelectionChanged="OnSettingChanged">
                                    <ComboBoxItem Content="通透 (Tahoe)" Tag="Clear" />
                                    <ComboBoxItem Content="平衡" Tag="Balanced" />
                                    <ComboBoxItem Content="磨砂" Tag="Frosted" />
                                </ComboBox>
                            </DockPanel>

                            <CheckBox x:Name="MenuBarBgCheck"
                                      Content="显示顶部菜单栏液态玻璃底色"
                                      Foreground="#F0FFFFFF"
                                      Checked="OnSettingChanged"
                                      Unchecked="OnSettingChanged" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="程序坞 (Dock)" FontSize="12" Foreground="#99FFFFFF" Margin="0,0,0,6" />
                    <Border Background="#1FFFFFFF" CornerRadius="10" Padding="12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="图标大小" Foreground="#F0FFFFFF" VerticalAlignment="Center" />
                                <Slider x:Name="IconSizeSlider" Minimum="36" Maximum="72" Width="160" HorizontalAlignment="Right" ValueChanged="OnSettingChanged" />
                            </DockPanel>

                            <CheckBox x:Name="MagnificationCheck"
                                      Content="悬停波浪放大"
                                      Foreground="#F0FFFFFF"
                                      Margin="0,0,0,8"
                                      Checked="OnSettingChanged"
                                      Unchecked="OnSettingChanged" />

                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="放大倍率" Foreground="#F0FFFFFF" VerticalAlignment="Center" />
                                <Slider x:Name="MagScaleSlider" Minimum="1.2" Maximum="2.0" SmallChange="0.1" Width="160" HorizontalAlignment="Right" ValueChanged="OnSettingChanged" />
                            </DockPanel>

                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="自动隐藏程序坞" Foreground="#F0FFFFFF" VerticalAlignment="Center" />
                                <ComboBox x:Name="AutoHideCombo" Width="130" HorizontalAlignment="Right" SelectionChanged="OnSettingChanged">
                                    <ComboBoxItem Content="关闭" Tag="Off" />
                                    <ComboBoxItem Content="始终隐藏" Tag="Always" />
                                    <ComboBoxItem Content="智能避让" Tag="Smart" />
                                </ComboBox>
                            </DockPanel>

                            <CheckBox x:Name="RecentAppsCheck"
                                      Content="在程序坞中显示最近使用的应用"
                                      Foreground="#F0FFFFFF"
                                      Checked="OnSettingChanged"
                                      Unchecked="OnSettingChanged" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
