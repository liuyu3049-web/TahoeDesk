<Window x:Class="GlassShell.UI.Settings.QuickSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:glass="clr-namespace:GlassShell.UI.Glass"
        Title="GlassShell 设置"
        Width="460"
        Height="532"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        Topmost="True">
    <Grid>
        <glass:LiquidGlassSurface x:Name="GlassBackdrop"
                                  CornerRadius="20"
                                  ShadowPadding="16"
                                  IsOverlayCard="True"
                                  IsDarkMode="True" />

        <DockPanel Margin="32,28,32,28">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <TextBlock Text="系统设置 · GlassShell"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SettingsFgBrush}"
                           VerticalAlignment="Center" />
                <Button Content="✕"
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        Width="26"
                        Height="26"
                        Background="{DynamicResource SettingsCloseBgBrush}"
                        Foreground="{DynamicResource SettingsFgBrush}"
                        BorderThickness="0"
                        Click="OnCloseClick" />
            </DockPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                <Button Content="恢复 Windows 原生任务栏并退出 GlassShell"
                        Height="34"
                        Background="#D8FF3B30"
                        Foreground="White"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Click="OnRestoreAndExitClick" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="外观与液态玻璃" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource SettingsSubtleBrush}" Margin="2,0,0,6" />
                    <Border Background="{DynamicResource SettingsCardBgBrush}"
                            BorderBrush="{DynamicResource SettingsCardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="深浅主题" Foreground="{DynamicResource SettingsFgBrush}" VerticalAlignment="Center" />
                                <ComboBox x:Name="ThemeCombo" Width="140" HorizontalAlignment="Right" SelectionChanged="OnSettingChanged" DropDownOpened="OnComboDropDownOpened">
                                    <ComboBoxItem Content="跟随系统" Tag="System" />
                                    <ComboBoxItem Content="浅色" Tag="Light" />
                                    <ComboBoxItem Content="深色" Tag="Dark" />
                                </ComboBox>
                            </DockPanel>

                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="液态玻璃通透度" Foreground="{DynamicResource SettingsFgBrush}" VerticalAlignment="Center" />
                                <ComboBox x:Name="OpacityCombo" Width="140" HorizontalAlignment="Right" SelectionChanged="OnSettingChanged" DropDownOpened="OnComboDropDownOpened">
                                    <ComboBoxItem Content="通透 (Tahoe)" Tag="Clear" />
                                    <ComboBoxItem Content="平衡" Tag="Balanced" />
                                    <ComboBoxItem Content="磨砂" Tag="Frosted" />
                                </ComboBox>
                            </DockPanel>

                            <CheckBox x:Name="MenuBarBgCheck"
                                      Content="显示顶部菜单栏液态玻璃底色"
                                      Foreground="{DynamicResource SettingsFgBrush}"
                                      Checked="OnSettingChanged"
                                      Unchecked="OnSettingChanged" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="程序坞 (Dock)" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource SettingsSubtleBrush}" Margin="2,0,0,6" />
                    <Border Background="{DynamicResource SettingsCardBgBrush}"
                            BorderBrush="{DynamicResource SettingsCardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="图标大小" Foreground="{DynamicResource SettingsFgBrush}" VerticalAlignment="Center" />
                                <Slider x:Name="IconSizeSlider" Minimum="36" Maximum="72" Width="165" HorizontalAlignment="Right" ValueChanged="OnSettingChanged" />
                            </DockPanel>

                            <CheckBox x:Name="MagnificationCheck"
                                      Content="悬停波浪放大"
                                      Foreground="{DynamicResource SettingsFgBrush}"
                                      Margin="0,0,0,8"
                                      Checked="OnSettingChanged"
                                      Unchecked="OnSettingChanged" />

                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="放大倍率" Foreground="{DynamicResource SettingsFgBrush}" VerticalAlignment="Center" />
                                <Slider x:Name="MagScaleSlider" Minimum="1.2" Maximum="2.0" SmallChange="0.1" Width="165" HorizontalAlignment="Right" ValueChanged="OnSettingChanged" />
                            </DockPanel>

                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="自动隐藏程序坞" Foreground="{DynamicResource SettingsFgBrush}" VerticalAlignment="Center" />
                                <ComboBox x:Name="AutoHideCombo" Width="140" HorizontalAlignment="Right" SelectionChanged="OnSettingChanged" DropDownOpened="OnComboDropDownOpened">
                                    <ComboBoxItem Content="关闭" Tag="Off" />
                                    <ComboBoxItem Content="始终隐藏" Tag="Always" />
                                    <ComboBoxItem Content="智能避让" Tag="Smart" />
                                </ComboBox>
                            </DockPanel>

                            <CheckBox x:Name="RecentAppsCheck"
                                      Content="在程序坞中显示最近使用的应用"
                                      Foreground="{DynamicResource SettingsFgBrush}"
                                      Margin="0,0,0,8"
                                      Checked="OnSettingChanged"
                                      Unchecked="OnSettingChanged" />

                            <CheckBox x:Name="WinKeyLaunchpadCheck"
                                      Content="单按 Win 键呼出启动台（组合键正常保留）"
                                      Foreground="{DynamicResource SettingsFgBrush}"
                                      Checked="OnSettingChanged"
                                      Unchecked="OnSettingChanged" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
