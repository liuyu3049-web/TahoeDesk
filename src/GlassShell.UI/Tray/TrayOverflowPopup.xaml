<Popup x:Class="GlassShell.UI.Tray.TrayOverflowPopup"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:glass="clr-namespace:GlassShell.UI.Glass"
       AllowsTransparency="True"
       PopupAnimation="Fade"
       StaysOpen="False"
       Placement="Bottom">
    <Grid MinWidth="212"
          MaxWidth="268"
          TextOptions.TextFormattingMode="Ideal"
          TextOptions.TextRenderingMode="Grayscale">
        <glass:LiquidGlassSurface x:Name="GlassBackdrop"
                                  CornerRadius="14"
                                  ShadowPadding="16"
                                  IsOverlayCard="True"
                                  IsDarkMode="True" />

        <StackPanel Margin="24,22,24,22">
            <WrapPanel x:Name="IconsWrapPanel"
                       Orientation="Horizontal"
                       ItemWidth="36"
                       ItemHeight="36"
                       MaxWidth="180" />

            <TextBlock x:Name="EmptyHintText"
                       Text="暂无折叠的托盘图标"
                       FontSize="12"
                       FontFamily="Microsoft YaHei UI, Segoe UI"
                       Foreground="{DynamicResource TraySubtleBrush}"
                       HorizontalAlignment="Center"
                       Margin="4,6,4,6"
                       Visibility="Collapsed" />

            <TextBlock Text="Shift + 左键可固定/取消固定到顶栏"
                       FontSize="10.5"
                       FontFamily="Microsoft YaHei UI, Segoe UI"
                       Foreground="{DynamicResource TraySubtleBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,6,0,0" />

            <Border Height="1" Background="{DynamicResource TrayDividerBrush}" Margin="0,8,0,8" />

            <Button x:Name="NativeTaskbarPeekButton"
                    Content="临时展开原生任务栏"
                    Height="28"
                    Background="{DynamicResource TrayBtnBgBrush}"
                    Foreground="{DynamicResource TrayFgBrush}"
                    BorderThickness="0"
                    FontSize="12"
                    FontFamily="Microsoft YaHei UI, Segoe UI"
                    Cursor="Hand"
                    Click="OnNativeTaskbarPeekClick">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="10,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Popup>
