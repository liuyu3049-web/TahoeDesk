<Popup x:Class="GlassShell.UI.ControlCenter.ControlCenterPopup"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:glass="clr-namespace:GlassShell.UI.Glass"
       AllowsTransparency="True"
       PopupAnimation="Fade"
       StaysOpen="False"
       Placement="Bottom">
    <Grid Width="344"
          TextOptions.TextFormattingMode="Ideal"
          TextOptions.TextRenderingMode="Grayscale">
        <glass:LiquidGlassSurface x:Name="GlassBackdrop"
                                  CornerRadius="18"
                                  ShadowPadding="16"
                                  IsOverlayCard="True"
                                  IsDarkMode="True" />

        <StackPanel Margin="26,24,26,24">
            <!-- Top Bento Row: Connectivity (Left) + Focus/Appearance (Right) -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="0.85*" />
                </Grid.ColumnDefinitions>

                <!-- Connectivity Bento Module -->
                <Border Grid.Column="0"
                        CornerRadius="14"
                        Background="{DynamicResource CcCardBgBrush}"
                        BorderBrush="{DynamicResource CcCardBorderBrush}"
                        BorderThickness="0.8"
                        Padding="11,10">
                    <StackPanel>
                        <!-- Wi-Fi Row -->
                        <DockPanel Margin="0,0,0,8">
                            <Button x:Name="WifiSettingsBtn"
                                    DockPanel.Dock="Right"
                                    Content="›"
                                    Width="20"
                                    Height="28"
                                    FontSize="15"
                                    Background="Transparent"
                                    Foreground="{DynamicResource CcSubtleBrush}"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    ToolTip="展开/收起附近 Wi-Fi 列表"
                                    Click="OnOpenWifiSettings" />
                            <Button x:Name="WifiToggleBtn"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    HorizontalContentAlignment="Left"
                                    Click="OnWifiToggleClick">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="WifiCircle" Width="28" Height="28" CornerRadius="14" Background="#0A84FF">
                                        <TextBlock Text="Wi" FontSize="10" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Wi-Fi" FontSize="12" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI, Segoe UI" Foreground="{DynamicResource CcFgBrush}" />
                                        <TextBlock x:Name="WifiStatusText" Text="检测中…" FontSize="10.5" FontFamily="Microsoft YaHei UI, Segoe UI" Foreground="{DynamicResource CcSubtleBrush}" MaxWidth="76" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </DockPanel>

                        <!-- Bluetooth Row -->
                        <DockPanel Margin="0,0,0,8">
                            <Button x:Name="BtSettingsBtn"
                                    DockPanel.Dock="Right"
                                    Content="›"
                                    Width="20"
                                    Height="28"
                                    FontSize="15"
                                    Background="Transparent"
                                    Foreground="{DynamicResource CcSubtleBrush}"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    ToolTip="打开 Windows 蓝牙设置"
                                    Click="OnOpenBluetoothSettings" />
                            <Button x:Name="BtToggleBtn"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    HorizontalContentAlignment="Left"
                                    Click="OnBluetoothToggleClick">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="BtCircle" Width="28" Height="28" CornerRadius="14" Background="#0A84FF">
                                        <TextBlock Text="BT" FontSize="10" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="蓝牙" FontSize="12" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI, Segoe UI" Foreground="{DynamicResource CcFgBrush}" />
                                        <TextBlock x:Name="BtStatusText" Text="检测中…" FontSize="10.5" FontFamily="Microsoft YaHei UI, Segoe UI" Foreground="{DynamicResource CcSubtleBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </DockPanel>

                        <!-- Clipboard History (Win+V) -->
                        <Button Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                HorizontalContentAlignment="Left"
                                Click="OnClipboardClick">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="28" Height="28" CornerRadius="14" Background="#34C759">
                                    <TextBlock Text="📋" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="剪贴板" FontSize="12" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI, Segoe UI" Foreground="{DynamicResource CcFgBrush}" />
                                    <TextBlock Text="Win+V 历史" FontSize="10.5" FontFamily="Microsoft YaHei UI, Segoe UI" Foreground="{DynamicResource CcSubtleBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Right Column: Focus + Appearance -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0"
                            Background="{DynamicResource CcCardBgBrush}"
                            BorderBrush="{DynamicResource CcCardBorderBrush}"
                            BorderThickness="0.8"
                            Cursor="Hand"
                            Click="OnFocusClick">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="28" Height="28" CornerRadius="14" Background="#5E5CE6">
                                            <TextBlock Text="☾" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="专注" FontSize="12" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI, Segoe UI" Foreground="{DynamicResource CcFgBrush}" />
                                            <TextBlock Text="勿扰设置" FontSize="10.5" FontFamily="Microsoft YaHei UI, Segoe UI" Foreground="{DynamicResource CcSubtleBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.86" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Grid.Row="2"
                            Background="{DynamicResource CcCardBgBrush}"
                            BorderBrush="{DynamicResource CcCardBorderBrush}"
                            BorderThickness="0.8"
                            Cursor="Hand"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            Click="OnThemeCycleClick">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="10">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.86" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="14" Background="#FF9F0A">
                                <TextBlock Text="◐" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="外观" FontSize="12" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI, Segoe UI" Foreground="{DynamicResource CcFgBrush}" />
                                <TextBlock x:Name="ThemeModeText" Text="跟随系统" FontSize="10.5" FontFamily="Microsoft YaHei UI, Segoe UI" Foreground="{DynamicResource CcSubtleBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>

            <!-- Inline Expandable Wi-Fi Network Picker (one-click connect for saved networks!) -->
            <Border x:Name="WifiDrawerCard"
                    Visibility="Collapsed"
                    CornerRadius="14"
                    Background="{DynamicResource CcCardBgBrush}"
                    BorderBrush="{DynamicResource CcCardBorderBrush}"
                    BorderThickness="0.8"
                    Padding="11,9"
                    Margin="0,0,0,10">
                <StackPanel>
                    <DockPanel Margin="2,0,2,6">
                        <TextBlock Text="附近 Wi-Fi 网络" FontSize="11.5" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI, Segoe UI" Foreground="{DynamicResource CcFgBrush}" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right"
                                Content="系统网络 ›"
                                FontSize="10.5"
                                FontFamily="Microsoft YaHei UI, Segoe UI"
                                Background="Transparent"
                                Foreground="{DynamicResource CcSubtleBrush}"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="OnOpenAvailableNetworksFlyout" />
                    </DockPanel>
                    <ScrollViewer MaxHeight="146" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="WifiNetworksList" />
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- Brightness Slider Card (auto-hidden when hardware unsupported) -->
            <Border x:Name="BrightnessCard"
                    CornerRadius="14"
                    Background="{DynamicResource CcCardBgBrush}"
                    BorderBrush="{DynamicResource CcCardBorderBrush}"
                    BorderThickness="0.8"
                    Padding="12,9"
                    Margin="0,0,0,10">
                <StackPanel>
                    <DockPanel Margin="0,0,0,5">
                        <TextBlock Text="显示器亮度" FontSize="11.5" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI, Segoe UI" Foreground="{DynamicResource CcFgBrush}" />
                        <TextBlock x:Name="BrightnessValueText" DockPanel.Dock="Right" HorizontalAlignment="Right" Text="80%" FontSize="11" Foreground="{DynamicResource CcSubtleBrush}" Typography.NumeralAlignment="Tabular" />
                    </DockPanel>
                    <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="100" Value="80" IsMoveToPointEnabled="True" ValueChanged="OnBrightnessChanged" />
                </StackPanel>
            </Border>

            <!-- Volume Slider Card -->
            <Border CornerRadius="14"
                    Background="{DynamicResource CcCardBgBrush}"
                    BorderBrush="{DynamicResource CcCardBorderBrush}"
                    BorderThickness="0.8"
                    Padding="12,9"
                    Margin="0,0,0,10">
                <StackPanel>
                    <DockPanel Margin="0,0,0,5">
                        <Button x:Name="MuteToggleButton"
                                DockPanel.Dock="Left"
                                Content="🔊"
                                Width="22"
                                Height="18"
                                FontSize="12"
                                Background="Transparent"
                                Foreground="{DynamicResource CcFgBrush}"
                                BorderThickness="0"
                                Cursor="Hand"
                                Margin="0,0,4,0"
                                Click="OnMuteToggleClick" />
                        <TextBlock Text="声音" FontSize="11.5" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI, Segoe UI" Foreground="{DynamicResource CcFgBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="VolumeValueText" DockPanel.Dock="Right" HorizontalAlignment="Right" Text="50%" FontSize="11" Foreground="{DynamicResource CcSubtleBrush}" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                    </DockPanel>
                    <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="50" IsMoveToPointEnabled="True" ValueChanged="OnVolumeChanged" />
                </StackPanel>
            </Border>

            <!-- Now Playing (WinRT SMTC) Media Card -->
            <Border CornerRadius="14"
                    Background="{DynamicResource CcCardBgBrush}"
                    BorderBrush="{DynamicResource CcCardBorderBrush}"
                    BorderThickness="0.8"
                    Padding="12,10">
                <DockPanel>
                    <Border Width="42" Height="42" CornerRadius="9" Background="{DynamicResource CcBtnBgBrush}" ClipToBounds="True" DockPanel.Dock="Left">
                        <Grid>
                            <TextBlock x:Name="MediaFallbackGlyph" Text="♫" FontSize="18" Foreground="{DynamicResource CcSubtleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="MediaArtworkImage" Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                        <Button Content="⏮" Width="26" Height="26" FontSize="12" Background="Transparent" Foreground="{DynamicResource CcFgBrush}" BorderThickness="0" Cursor="Hand" Click="OnPrevTrackClick" />
                        <Button x:Name="PlayPauseBtn" Content="▶" Width="28" Height="28" FontSize="13" Background="{DynamicResource CcBtnBgBrush}" Foreground="{DynamicResource CcFgBrush}" BorderThickness="0" Cursor="Hand" Margin="2,0" Click="OnPlayPauseClick" />
                        <Button Content="⏭" Width="26" Height="26" FontSize="12" Background="Transparent" Foreground="{DynamicResource CcFgBrush}" BorderThickness="0" Cursor="Hand" Click="OnNextTrackClick" />
                    </StackPanel>

                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="MediaTitleText" Text="未在播放" FontSize="12.5" FontWeight="SemiBold" FontFamily="Microsoft YaHei UI, Segoe UI" Foreground="{DynamicResource CcFgBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="MediaArtistText" Text="打开音乐或视频即可在此控制" FontSize="10.5" FontFamily="Microsoft YaHei UI, Segoe UI" Foreground="{DynamicResource CcSubtleBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </Grid>
</Popup>
