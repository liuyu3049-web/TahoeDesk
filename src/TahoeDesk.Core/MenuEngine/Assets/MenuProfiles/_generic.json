{
  "menus": [
    {
      "title": "文件",
      "children": [
        { "title": "新建", "shortcut": "Ctrl+N" },
        { "title": "打开…", "shortcut": "Ctrl+O" },
        { "title": "保存", "shortcut": "Ctrl+S" },
        { "separator": true },
        { "title": "打印…", "shortcut": "Ctrl+P" },
        { "separator": true },
        { "title": "关闭窗口", "shortcut": "Alt+F4", "windowOp": "close" }
      ]
    },
    {
      "title": "编辑",
      "children": [
        { "title": "撤销", "shortcut": "Ctrl+Z" },
        { "title": "重做", "shortcut": "Ctrl+Y" },
        { "separator": true },
